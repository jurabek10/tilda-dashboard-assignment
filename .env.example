# ============================================
# Shared
# ============================================
NODE_ENV=development

# ============================================
# Backend (apps/api)
# ============================================
PORT=4000

# PostgreSQL connection.
# - Inside Docker Compose, the API reaches the DB at `postgres:5432` (set in compose).
# - Locally, use the host port your compose maps to (default: 5434).
DATABASE_URL=postgresql://tilda:tilda@localhost:5434/tilda?schema=public

# JWT_SECRET=very-very-secret-password
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# data.go.kr Open API — "건강보험심사평가원_의료기관종별 진료과목별 진료비 통계"
# Dataset page: https://www.data.go.kr/data/15139382/fileData.do
# DATA_GO_KR_API_KEY=78af8c3c0e827196b42a028a1e5a078bd6ac555ef51f341324da38229c08512d
DATA_GO_KR_API_KEY=YOUR_DATA_GO_KR_KEY_HERE
DATA_GO_KR_BASE_URL=https://api.odcloud.kr/api
DATA_GO_KR_DATASET_PATH=/15139382/v1/uddi:638707af-cc4b-48e5-9ff8-938aae8b637a

# Cookie behavior — set COOKIE_SECURE=true in production over HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:3000

# ============================================
# Frontend (apps/web)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
INTERNAL_API_URL=http://localhost:4000/api
